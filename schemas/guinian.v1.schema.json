{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/XDarkness25/-/raw/main/schemas/guinian.v1.schema.json",
  "title": "一念·归念记录 v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "type",
    "title",
    "subject",
    "one_sentence",
    "core_points",
    "misconceptions",
    "examples",
    "open_questions"
  ],
  "properties": {
    "schema_version": {
      "const": "yinian.guinian/v1"
    },
    "type": {
      "const": "guinian"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["discipline", "topic", "tags"],
      "properties": {
        "discipline": {
          "type": "string",
          "minLength": 1
        },
        "topic": {
          "type": "string",
          "minLength": 1
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "one_sentence": {
      "type": "string",
      "minLength": 1
    },
    "core_points": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "statement", "intuition", "key_relation"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "intuition": { "type": "string" },
          "key_relation": { "type": "string" }
        }
      }
    },
    "misconceptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mistake", "correction"],
        "properties": {
          "mistake": { "type": "string", "minLength": 1 },
          "correction": { "type": "string", "minLength": 1 }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "title", "prompt", "solution", "language"],
        "properties": {
          "kind": {
            "enum": ["concept", "calculation", "proof", "problem", "code"]
          },
          "title": { "type": "string", "minLength": 1 },
          "prompt": { "type": "string", "minLength": 1 },
          "solution": { "type": "string", "minLength": 1 },
          "language": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
